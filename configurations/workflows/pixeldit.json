{
  "id": "pixeldit",
  "workflow": "pixeldit",
  "friendly_name": "PixelDiT 1300M (pixel-space)",
  "default": false,
  "requirements": {
    "checkpoint": "pixeldit-1300m-1024px",
    "text_encoders": [
      "gemma-2-2b-it-elm"
    ],
    "vae": "pixel-space-vae"
  },
  "params": {
    "loader": "unet",
    "clip_type": "pixeldit",
    "dual": false,
    "latent": "pixel",
