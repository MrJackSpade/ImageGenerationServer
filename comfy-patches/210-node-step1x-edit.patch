index 0000000..ea2a27f
--- /dev/null
+++ b/utils/text_encoder_paths.py
@@ -0,0 +1,65 @@
+"""Where the Qwen2.5-VL text encoder lives, resolved rather than hardcoded.
+
+Upstream reads `folder_paths.get_folder_paths("text_encoders")[0]`, which is ComfyUI's OWN
+`models/text_encoders` and nothing else. An install that keeps its text encoders somewhere else --
+anything with an `extra_model_paths.yaml`, which is the usual arrangement once the models predate
+the ComfyUI install -- has the encoder on a path index [0] never looks at, so the node lists an
+empty dropdown and then fails to load.
+
+Searching EVERY configured root fixes that without naming a machine's drive. STEP1X_TEXT_ENCODER_DIR
+overrides the lot for a layout none of this anticipates.
+"""
+import os
+
+
+def _roots():
+    """Every directory ComfyUI considers a text-encoder root, plus the env override, in priority order."""
+    from_env = os.environ.get("STEP1X_TEXT_ENCODER_DIR")
+    if from_env:
+        return [from_env]
+
+    import folder_paths
+    roots = []
+    # "text_encoders" is the current name; "clip" is the same directory under ComfyUI's older key, and
+    # installs configured years apart use one or the other. Both, deduped, in the order ComfyUI gives them.
+    for key in ("text_encoders", "clip"):
+        try:
+            roots.extend(folder_paths.get_folder_paths(key))
+        except KeyError:
+            # Not a folder ComfyUI knows -- not an error, just nothing to contribute.
+            pass
+
+    seen, unique = set(), []
+    for root in roots:
+        normalised = os.path.normcase(os.path.abspath(root))
+        if normalised not in seen:
+            seen.add(normalised)
+            unique.append(root)
+    return unique
+
+
+def list_text_encoders():
+    """The subdirectories offered in the dropdown, across every root. A model is a DIRECTORY here."""
+    names, seen = [], set()
+    for root in _roots():
+        if not os.path.isdir(root):
+            continue
+        for name in sorted(os.listdir(root)):
+            if name not in seen and os.path.isdir(os.path.join(root, name)):
+                seen.add(name)
+                names.append(name)
+    return names
+
+
+def resolve_text_encoder(name):
+    """The full path of a chosen encoder. Raises naming every root searched -- an empty string
+    or a silently wrong path here surfaces much later as an unreadable from_pretrained error."""
+    roots = _roots()
+    for root in roots:
+        candidate = os.path.join(root, name)
+        if os.path.isdir(candidate):
+            return candidate
+    raise FileNotFoundError(
+        "Text encoder '{}' is not in any of ComfyUI's text-encoder folders: {}. "
+        "Put it in one of them, or set STEP1X_TEXT_ENCODER_DIR.".format(name, ", ".join(roots) or "(none configured)")
+    )
