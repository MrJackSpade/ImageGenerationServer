         # 6. Denoising loop
         # We set the index here to remove DtoH sync, helpful especially during compilation.
         # Check out more details here: https://github.com/huggingface/diffusers/pull/11696
-        self.scheduler.set_begin_index(0)
+        # img2img (reference > 0 -> strength < 1.0): seed the generation latent from the SOURCE (images[0]) and run
+        # only the last `strength` fraction of the schedule. strength == 1.0 (default) is the original full
+        # generation path, untouched — so existing behaviour is unchanged unless the caller asks for a partial denoise.
+        if strength < 1.0 and images is not None and len(images) > 0:
+            init_steps = max(1, int(round(num_inference_steps * strength)))
+            t_start = max(0, num_inference_steps - init_steps)
+            self.scheduler.set_begin_index(t_start)
+            timesteps = timesteps[t_start:]
+            self._num_timesteps = len(timesteps)
+            src = images[0]
+            if isinstance(src, torch.Tensor) and src.size(1) == self.latent_channels:
+                src_lat = src.to(device=device, dtype=prompt_embeds.dtype)
+            else:
+                src_img = src.to(device=device, dtype=prompt_embeds.dtype)
+                # The img2img init latent must live on the SAME grid as `latents` (height x width). Step-3
+                # preprocessing resized images[0] to a PREFERRED_KONTEXT_RESOLUTION aspect bucket for the
+                # conditioning path, which generally differs from the generation grid — encoding it as-is
+                # packs to a different sequence length, so the (1-sigma)*src + sigma*noise blend below fails
+                # ("size of tensor a must match tensor b at dim 1"). Resize to (height, width) first.
+                if tuple(src_img.shape[-2:]) != (height, width):
+                    src_img = torch.nn.functional.interpolate(src_img, size=(height, width), mode="bilinear", align_corners=False)
+                src_lat = self._encode_vae_image(image=src_img, generator=generator)
+            src_lat = self._pack_latents(src_lat, latents.shape[0], num_channels_latents, src_lat.shape[2], src_lat.shape[3])
+            sigma0 = (timesteps[:1].to(device=latents.device, dtype=latents.dtype) / 1000.0).view(-1, 1, 1)
+            latents = (1.0 - sigma0) * src_lat + sigma0 * latents   # flow-match: noise the source at the start sigma
+        else:
+            self.scheduler.set_begin_index(0)
+        # PIXEL-ART: pin the VAE on the GPU before the loop. The per-step manifold projection below calls
+        # self.vae.decode/encode INSIDE the loop; under enable_model_cpu_offload the offload chain is
+        # ...->transformer->vae, so the VAE's own CpuOffload hook fires prev_module_hook.offload() on every
+        # vae.decode and evicts the ~12GB int8 transformer to CPU, which the next step reloads (the 14.5<->4.3GB
+        # ping-pong, and the reload is the slowdown). Dropping the VAE's offload hook keeps both resident
+        # (int8 transformer + small VAE fit a 24GB card) so the transformer is never evicted mid-loop.
+        # This MUST re-run on EVERY call, not once: maybe_free_model_hooks() at the end of __call__ re-runs
+        # enable_model_cpu_offload(), which RE-INSTALLS the VAE hook — so a one-shot guard left every image
+        # after the first thrashing again (the hook is back, so the per-step evict returns).
+        if pixel_opts is not None:
+            from accelerate.hooks import remove_hook_from_module
+            remove_hook_from_module(self.vae)
+            self.vae.to(latents.device)
         with self.progress_bar(total=num_inference_steps) as progress_bar:
             for i, t in enumerate(timesteps):
                 update_func()
@@ -1106,6 +1147,41 @@ class DreamOmni2Pipeline(
                     neg_noise_pred = neg_noise_pred[:, : latents.size(1)]
                     noise_pred = neg_noise_pred + true_cfg_scale * (noise_pred - neg_noise_pred)
 
+                # PIXEL-ART per-step manifold projection: project the flow-matching x0 estimate
+                # (x0 = x_t - sigma*v) onto a fixed grid+palette via the VAE + PixelHarness quant, then
+                # feed back a corrected velocity so the scheduler step steers toward the projected x0.
+                # Same math as the PixelManifoldProjection node; engaged only when pixel_opts is set.
+                if pixel_opts is not None:
+                    _n = len(timesteps)
+                    _frac = i / max(_n - 1, 1)
+                    if pixel_opts["start"] <= _frac <= pixel_opts["end"] and (i % pixel_opts["every"] == 0):
+                        _sigma = self.scheduler.sigmas[i].to(latents)
+                        if float(_sigma) > 1e-6:
+                            import numpy as _np
+                            from PIL import Image as _Image
+                            if not hasattr(self, "_ph_quant"):
+                                from .rh_paths import pixelharness_quant as _phq  # sibling node pack, not a model
+                                self._ph_quant = _phq()
+                            _q = self._ph_quant
+                            _w = pixel_opts["w_start"] + (pixel_opts["w_end"] - pixel_opts["w_start"]) * _frac
+                            _x0 = latents - _sigma * noise_pred
+                            _lat = self._unpack_latents(_x0, height, width, self.vae_scale_factor)
+                            _lat = (_lat / self.vae.config.scaling_factor) + self.vae.config.shift_factor
+                            _img = self.vae.decode(_lat.to(self.vae.dtype), return_dict=False)[0]
+                            _a = ((_img.float() / 2 + 0.5).clamp(0, 1)[0].permute(1, 2, 0).cpu().numpy() * 255 + 0.5).astype(_np.uint8)
+                            _H, _W = _a.shape[:2]
+                            _gw, _gh = _q.grid_for_aspect(_W, _H, pixel_opts["grid_w"], pixel_opts["grid_h"], pixel_opts["virtual_resolution"])
+                            _pal = _q.resolve_palette(pixel_opts["palette"], img_u8=_a, grid=(_gw, _gh))
+                            _g = _q.quantize(_a, _gw, _gh, _pal, method=pixel_opts["method"])
+                            _r = _q.render(_g, _pal, scale=1)
+                            if _r.shape[0] != _H or _r.shape[1] != _W:
+                                _r = _np.asarray(_Image.fromarray(_r).resize((_W, _H), _Image.NEAREST), dtype=_np.uint8)
+                            _proj = (torch.from_numpy(_r.astype(_np.float32) / 255.0).permute(2, 0, 1)[None].to(_img) * 2 - 1)
+                            _pl = self._encode_vae_image(_proj.to(self.vae.dtype), generator=None)
+                            _pp = self._pack_latents(_pl, _pl.shape[0], _pl.shape[1], _pl.shape[2], _pl.shape[3]).to(_x0)
+                            _x0b = (1.0 - _w) * _x0 + _w * _pp
+                            noise_pred = (latents - _x0b) / _sigma
+
                 # compute the previous noisy sample x_t -> x_t-1
                 latents_dtype = latents.dtype
                 latents = self.scheduler.step(noise_pred, t, latents, return_dict=False)[0]
