diff --git a/rh_paths.py b/rh_paths.py
new file mode 100644
index 0000000..625822c
--- /dev/null
+++ b/rh_paths.py
@@ -0,0 +1,94 @@
+"""Where DreamOmni2's weights live: whichever folder ComfyUI keeps that kind of thing in.
+
+Upstream builds every path from `folder_paths.models_dir` — ComfyUI's own `models/` and nothing else — which
+ignores `extra_model_paths.yaml`, so an install whose models are anywhere else finds none of them. That is what
+led to the absolute paths this replaces.
+
+Each asset is asked for by KIND, because each one already has a home ComfyUI understands: the Kontext pipeline
+is a diffusers model, the VLM is a text encoder, and the two adapters are LoRAs. Nothing is searched for and
+nothing is guessed at — a missing file names the folder it belongs in.
+"""
+import os
+
+#: The Kontext pipeline, under any configured `diffusers` folder.
+BASE_MODEL = "FLUX.1-Kontext-dev"
+
+#: The instruction VLM, under any configured `text_encoders` folder. It is a Qwen2.5-VL directory, the same
+#: shape as the encoder Step1X-Edit uses, and lives beside it.
+VLM_MODEL = "DreamOmni2-vlm-model"
+
+#: The two adapters, in the `loras` folder like every other LoRA.
+GEN_LORA = "DreamOmni2-gen_lora.safetensors"
+EDIT_LORA = "DreamOmni2-edit_lora.safetensors"
+
+
+def _folder(kind):
+    import folder_paths
+    return folder_paths.get_folder_paths(kind)
+
+
+def _directory(kind, name):
+    """A model that is a DIRECTORY (diffusers pipeline, transformers model), under a folder of `kind`."""
+    folders = _folder(kind)
+    for base in folders:
+        candidate = os.path.join(base, name)
+        if os.path.isdir(candidate):
+            return candidate
+    raise FileNotFoundError(
+        "DreamOmni2 needs '{}' in ComfyUI's {} folder. Looked in: {}.".format(
+            name, kind, ", ".join(folders) or "(none configured)"))
+
+
+def base_model(name=None):
+    """The diffusers base pipeline directory `name`, resolved under any configured `diffusers` folder. `name` is
+    the app's model-ref binding, passed as the Edit pipeline's REQUIRED base_model input -- and the Edit node
+    rejects a missing one before this runs, so an edit never defaults silently. The `name or BASE_MODEL` default
+    exists ONLY for the Gen pipeline, which has no such input and always loads the built-in FLUX.1-Kontext-dev."""
+    return _directory("diffusers", name or BASE_MODEL)
+
+
+def list_base_models():
+    """Every diffusers pipeline directory ComfyUI can see, for the Edit Pipeline's `base_model` dropdown. A
+    diffusers model is a DIRECTORY carrying a model_index.json, so qualifying subdirectories of every configured
+    `diffusers` folder are listed -- not files. Empty when none are installed: the node still registers and its
+    workflows presence-gate off rather than offering a model that is not on disk."""
+    names = []
+    for base in _folder("diffusers"):
+        if not os.path.isdir(base):
+            continue
+        for entry in sorted(os.listdir(base)):
+            if entry not in names and os.path.isfile(os.path.join(base, entry, "model_index.json")):
+                names.append(entry)
+    return names
+
+
+def vlm_model():
+    return _directory("text_encoders", VLM_MODEL)
+
+
+def lora(name):
+    """A LoRA file, resolved the way every other LoRA in ComfyUI is."""
+    import folder_paths
+    path = folder_paths.get_full_path("loras", name)
+    if path:
+        return path
+    raise FileNotFoundError(
+        "DreamOmni2 needs '{}' in ComfyUI's loras folder. Looked in: {}.".format(
+            name, ", ".join(_folder("loras")) or "(none configured)"))
+
+
+def pixelharness_quant():
+    """PixelHarness's `quant.py`, loaded by path because it is a sibling node pack rather than an importable
+    module. It sits next to this pack in `custom_nodes/`, so find it there."""
+    candidate = os.path.join(
+        os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "ComfyUI-PixelHarness", "quant.py")
+    if not os.path.isfile(candidate):
+        raise FileNotFoundError(
+            "Pixel projection needs the ComfyUI-PixelHarness pack installed next to this one; "
+            "its quant.py is not at {}.".format(candidate))
+
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("ph_quant", candidate)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
