<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY one-time migration tool. Deliberately NOT in ImageGen.slnx and NOT referenced by the app: a backfill is
    not a feature, and shipping migrations inside the primary app is how they end up running forever. Delete this
    directory once every stored tag key and prompt is HTML-decoded. See Program.cs for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BackfillTagDecode</RootNamespace>
    <!-- The app's doc-comment analyzer is not worth satisfying in a file that is going to be deleted. -->
    <NoWarn>$(NoWarn);IMGDOC001</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageGen.Application\ImageGen.Application.csproj" />
    <ProjectReference Include="..\..\src\ImageGen.Infrastructure\ImageGen.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
