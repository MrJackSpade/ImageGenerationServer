<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY one-time migration tool. Deliberately NOT in ImageGen.slnx and NOT referenced by the app: a backfill is
    not a feature, and shipping migrations inside the primary app is how they end up running forever. Delete this
    directory once every deployment has been migrated. See Program.cs for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SplitEncryptedBlobs</RootNamespace>
    <!--
      Analyzers scoped out for this throwaway, single-provider (SqlClient-only) tool, same rationale as IMGDOC001:
      not worth satisfying in a file slated for deletion. IMGDB001/002 enforce cross-provider portability that does
      not apply here (hardwired to SQL Server, where COUNT(*) is int and the typed getters return their declared
      types); IMGNULL001 is the null-forgiving ! on the (int)ExecuteScalar casts those same reads use. See issue #101.
    -->
    <NoWarn>$(NoWarn);IMGDOC001;IMGDB001;IMGDB002;IMGNULL001</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageGen.Application\ImageGen.Application.csproj" />
    <ProjectReference Include="..\..\src\ImageGen.Infrastructure\ImageGen.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
