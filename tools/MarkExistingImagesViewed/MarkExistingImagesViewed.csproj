<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THROWAWAY one-time migration tool. Deliberately NOT in ImageGen.slnx and NOT referenced by the app: a backfill is
    not a feature, and shipping migrations inside the primary app is how they end up running forever. Delete this
    directory once it has been run against every deployment. See Program.cs for how to run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MarkExistingImagesViewed</RootNamespace>
    <!--
      Analyzers scoped out for this throwaway, single-provider (SqlClient-only) tool, same rationale as IMGDOC001:
      not worth satisfying in a file slated for deletion. IMGDB002 flags the (int)ExecuteScalar unbox (safe here:
      hardwired to SQL Server, where COUNT(*) is int), and IMGNULL001 is the null-forgiving ! that same cast uses.
      IMGDB001 is listed for parity with the sibling tool. See issue #101.
    -->
    <NoWarn>$(NoWarn);IMGDOC001;IMGDB001;IMGDB002;IMGNULL001</NoWarn>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

</Project>
