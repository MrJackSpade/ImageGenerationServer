# Copy to .env and edit. Only COMFY_MODELS_DIR has to be set; the rest have working defaults.
#
#   cp .env.example .env
#   docker compose up

# REQUIRED. A ComfyUI-style models directory — the folder that CONTAINS the sub-folders checkpoints/,
# diffusion_models/, text_encoders/, vae/, loras/, clip_vision/, controlnet/, upscale_models/. Mounted read-only
# into the bundled ComfyUI; never copied into the image. If you do not already run ComfyUI you will not have this —
# create the sub-folders and put each model in the one for its kind. INSTALL.md (→ Docker) has the tree and a
# one-line mkdir. Nothing here downloads models; they are yours to place.
COMFY_MODELS_DIR=/path/to/your/models

# Only for AMD cards ROCm does not officially support: 10.3.0 for RDNA2 (6700/6600), 11.0.0 for some RDNA3 (7600).
# Leave empty otherwise — a wrong value is worse than none. Ignored by the nvidia profile.
HSA_OVERRIDE_GFX_VERSION=

# Host port to publish the app on.
IMAGEGEN_PORT=8080

# A shared code required to register. Leave empty for open sign-up; set it if anything other than you can reach the
# port. This is the only thing standing between a reachable instance and a stranger's account.
REGISTRATION_CODE=

# Both default true, which is the trusted-single-box behaviour this app has always had.
#   EXPOSE_STACK_TRACES=false  — 500s carry the exception message instead of the full trace. The trace still goes to
#                               the log file, so this costs diagnosability in the browser, not in the record.
#   TRUST_ALL_PROXIES=false    — stop believing X-Forwarded-* from any caller. Set false unless a reverse proxy you
#                               control is the only thing that can reach the app.
EXPOSE_STACK_TRACES=true
TRUST_ALL_PROXIES=true

# Refuse new submissions below this much free memory, rather than accepting work that cannot render. On Linux this
# reads the HOST's available memory, not a container limit, so lower it if you have capped the container.
MIN_AVAILABLE_MEMORY_MB=500
