@*TODO: CHECK FOR FALLBACKS*@
@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }

<section class="account">
    <div class="card">
        <h2>Sign in</h2>
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="auth-error">@Model.Error</div>
        }
        <form method="post" action="/account/login">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input name="username" value="@Model.Username" placeholder="Username" autocomplete="username" required autofocus />
            <input name="password" type="password" placeholder="Password" autocomplete="current-password" required />
            <button type="submit">Sign in</button>
        </form>
        <p class="auth-toggle"><a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
    </div>
</section>
