<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ImageGen.Application\ImageGen.Application.csproj" />
    <ProjectReference Include="..\ImageGen.Infrastructure\ImageGen.Infrastructure.csproj" />
    <ProjectReference Include="..\ImageGen.Comfy\ImageGen.Comfy.csproj" />
    <ProjectReference Include="..\ImageGen.Media\ImageGen.Media.csproj" />
    <ProjectReference Include="..\ImageGen.Api\ImageGen.Api.csproj" />
    <ProjectReference Include="..\ImageGen.TagModel\ImageGen.TagModel.csproj" />
  </ItemGroup>


  <!-- GetUserId (ClaimsPrincipal extension) now lives in the Api layer; make it available across the host + controllers. -->
  <ItemGroup>
    <Using Include="ImageGen.Api.Auth" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The ComfyUI patch payload. Both directories are READ AT RUNTIME by the patches page, so they have to travel
       with the binary the way the catalogue does: comfy-patches/ holds the authored diffs, and comfy-nodes/ holds
       the node packs this repo owns, which are turned into diffs in memory (see ComfyPatchCatalog). __pycache__ is
       Python's, written where these get installed, and is never part of a pack. -->
  <ItemGroup>
    <Content Include="..\..\comfy-patches\**" LinkBase="comfy-patches"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\comfy-nodes\**" LinkBase="comfy-nodes" Exclude="..\..\comfy-nodes\**\__pycache__\**"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Client JS must consume JSON, never HTML. Enforced here because the failure spreads: one whole-page HTML
       poll was copied across six pages before anyone noticed. Windows-only guard; skipped elsewhere so a Linux
       publish (the Docker build) is unaffected. -->
  <Target Name="CheckJsJsonOnly" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../tools/check-js-json-only.ps1&quot;"
          ContinueOnError="false" />
  </Target>

</Project>
